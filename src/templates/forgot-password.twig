{% extends "base.twig" %}
{% block title %}Reset Password{% endblock %}
{% block content %}
<div class="ciq-auth-wrap">
    <div class="ciq-auth-card">
        <div class="ciq-auth-header">
            <span class="ciq-brand-mark">C</span>
            <h1 class="ciq-auth-title">Reset Password</h1>
            <p class="ciq-auth-tagline">Enter your email and choose a new password</p>
        </div>

        {% if error %}
        <div class="ciq-auth-error">{{ error }}</div>
        {% endif %}

        {% if success %}
        <div class="ciq-auth-success">{{ success }}</div>
        {% endif %}

        <form class="ciq-auth-form" method="post" action="/api/forgot-password">
            {{ form_token() }}
            <div class="ciq-field">
                <label for="resetEmail">Email</label>
                <input type="email" id="resetEmail" name="email" placeholder="you@example.com" required>
            </div>
            <div class="ciq-field">
                <label for="newPassword">New Password</label>
                <div class="ciq-password-wrap">
                    <input type="password" id="newPassword" name="new_password" placeholder="At least 8 characters" required>
                    <button type="button" class="ciq-password-toggle" data-toggle-password="newPassword" aria-label="Show password">Show</button>
                </div>
            </div>
            <div class="ciq-field">
                <label for="confirmPassword">Confirm New Password</label>
                <div class="ciq-password-wrap">
                    <input type="password" id="confirmPassword" name="confirm_password" placeholder="Re-enter your new password" required>
                    <button type="button" class="ciq-password-toggle" data-toggle-password="confirmPassword" aria-label="Show password">Show</button>
                </div>
            </div>
            <button type="submit" class="ciq-btn ciq-btn-primary ciq-btn-full">Reset Password</button>
        </form>

        <p class="ciq-auth-footer">
            <a href="/login" class="ciq-link">&larr; Back to Sign In</a>
        </p>
    </div>
</div>
{% endblock %}
