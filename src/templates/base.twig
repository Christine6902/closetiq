<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ APP_NAME }}{% endblock %} · {{ APP_NAME }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/closetiq.css">
{% block head %}{% endblock %}
</head>
<body>
{% include "partials/nav.twig" %}
<main class="ciq-main">
{% block content %}{% endblock %}
</main>
<script src="/js/frond.min.js"></script>
<script>
function toggleAddForm(){var p=document.getElementById('addPanel');if(p)p.hidden=!p.hidden;}
document.addEventListener('click',function(e){
  var el=e.target.closest('[data-action]');if(!el)return;
  var a=el.dataset.action;
  if(a==='toggle-add'){toggleAddForm();}
  if(a==='save-item'){e.preventDefault();if(window.saveForm){saveForm('itemForm','/api/wardrobe','formMessage',function(){location.reload();});}else{document.getElementById('itemForm').submit();}}
});
document.addEventListener('submit',function(e){
  var f=e.target.closest('[data-delete-id]');if(!f)return;e.preventDefault();
  var id=f.dataset.deleteId;
  if(window.sendRequest){sendRequest('/api/wardrobe/'+id+'/delete',{},'POST',function(){location.reload();});}
});
</script>
{% block scripts %}{% endblock %}
</body>
</html>
