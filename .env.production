# ClosetIQ — production environment
# Copy to .env on your server, or set as environment variables in your hosting dashboard

TINA4_DEBUG=false
TINA4_LOG_LEVEL=INFO
TINA4_SECRET=CHANGE-ME-TO-A-RANDOM-64-CHAR-STRING
TINA4_DATABASE_URL=sqlite:///data/app.db
TINA4_NO_BROWSER=true

# For PostgreSQL (recommended for production):
# TINA4_DATABASE_URL=postgresql://localhost:5432/closetiq
# TINA4_DATABASE_USERNAME=closetiq
# TINA4_DATABASE_PASSWORD=secure-password-here
